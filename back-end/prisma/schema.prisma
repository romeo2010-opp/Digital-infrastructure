  action         String          @db.VarChar(96)
  old_value      String?         @db.VarChar(255)
  new_value      String?         @db.VarChar(255)
  metadata_json  Json?
  created_at     DateTime        @default(now()) @db.Timestamp(3)
  mera_users     mera_users?     @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_regulator_task_activity_actor")
  regulator_tasks regulator_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_regulator_task_activity_task")

  @@index([action, created_at], map: "idx_regulator_task_activity_action_time")
  @@index([actor_user_id], map: "idx_regulator_task_activity_actor")
  @@index([task_id, created_at], map: "idx_regulator_task_activity_task_time")
}

model regulator_task_evidence {
  id                          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  task_id                     BigInt          @db.UnsignedBigInt
  uploaded_by_user_id         BigInt          @db.UnsignedBigInt
  evidence_type               String          @db.VarChar(64)
  title                       String          @db.VarChar(180)
  description                 String?         @db.Text
  file_url                    String?         @db.VarChar(1000)
  linked_existing_evidence_id String?         @db.VarChar(96)
  created_at                  DateTime        @default(now()) @db.Timestamp(3)
  mera_users                  mera_users      @relation(fields: [uploaded_by_user_id], references: [id], onUpdate: Restrict, map: "fk_regulator_task_evidence_uploader")
  regulator_tasks             regulator_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_regulator_task_evidence_task")

  @@index([task_id, created_at], map: "idx_regulator_task_evidence_task_time")
  @@index([uploaded_by_user_id], map: "idx_regulator_task_evidence_uploader")
}

model regulator_task_watchers {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  task_id         BigInt          @db.UnsignedBigInt
  user_id         BigInt          @db.UnsignedBigInt
  created_at      DateTime        @default(now()) @db.Timestamp(3)
  mera_users      mera_users      @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_regulator_task_watchers_user")
  regulator_tasks regulator_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_regulator_task_watchers_task")

  @@unique([task_id, user_id], map: "uq_regulator_task_watchers_task_user")
  @@index([user_id], map: "idx_regulator_task_watchers_user")
}

model mera_notifications {
  id                 BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  public_id          String                  @unique(map: "public_id") @db.Char(26)
  user_id            BigInt                  @db.UnsignedBigInt
  type               mera_notifications_type
  title              String                  @db.VarChar(180)
  message            String                  @db.Text
  linked_entity_type String?                 @db.VarChar(64)
  linked_entity_id   String?                 @db.VarChar(96)
  read_at            DateTime?               @db.Timestamp(3)
  created_at         DateTime                @default(now()) @db.Timestamp(3)
  mera_users         mera_users              @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_mera_notifications_user")

  @@index([linked_entity_type, linked_entity_id], map: "idx_mera_notifications_linked_entity")
  @@index([type, created_at], map: "idx_mera_notifications_type_time")
  @@index([user_id, read_at, created_at], map: "idx_mera_notifications_user_read_time")
}

model audit_logs_mera {
  id                 BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  actor_id           BigInt?     @db.UnsignedBigInt
  actor_name         String?     @db.VarChar(120)
  actor_role         String?     @db.VarChar(64)
  permission_code    String?     @db.VarChar(96)
  action_type        String      @db.VarChar(96)
  action_description String      @db.Text
  affected_entity    String?     @db.VarChar(255)
  ip_address         String?     @db.VarChar(64)
  device_info        String?     @db.VarChar(255)
  created_at         DateTime    @default(now()) @db.Timestamp(3)
  mera_users         mera_users? @relation(fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs_mera_actor")

  @@index([action_type, created_at], map: "idx_audit_logs_mera_action_time")
  @@index([actor_id, created_at], map: "idx_audit_logs_mera_actor_time")
}

model auth_sessions {
  id                 BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  public_id          String       @unique(map: "public_id") @db.Char(26)
  user_id            BigInt       @db.UnsignedBigInt
  station_id         BigInt?      @db.UnsignedBigInt
  role_id            Int?         @db.UnsignedTinyInt
  refresh_token_hash String       @db.VarChar(255)
  user_agent         String?      @db.VarChar(255)
  ip_address         String?      @db.VarChar(64)
  revoked_at         DateTime?
  expires_at         DateTime
  created_at         DateTime     @default(now()) @db.Timestamp(3)
  updated_at         DateTime     @default(now()) @db.Timestamp(3)
  staff_roles        staff_roles? @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions_role")
  stations           stations?    @relation(fields: [station_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_auth_sessions_station")
  users              users        @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_auth_sessions_user")

  @@index([role_id], map: "fk_auth_sessions_role")
  @@index([station_id], map: "fk_auth_sessions_station")
  @@index([expires_at], map: "idx_auth_sessions_expires")
  @@index([user_id], map: "idx_auth_sessions_user")
}

model IngestedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique @map("event_id")
  stationId   String   @map("station_id")
  deviceId    String   @map("device_id")
  actorUserId String   @map("actor_user_id")
  type        String
  payload     Json
  occurredAt  DateTime @map("occurred_at")
  receivedAt  DateTime @default(now()) @map("received_at")

  @@map("ingested_events")
}

model SupportTicket {
  id            String   @id @default(cuid())
  stationId     String   @map("station_id")
  userId        String   @map("user_id")
  category      String
  severity      String
  title         String
  description   String
  screenshotUrl String?  @map("screenshot_url")
  status        String   @default("OPEN")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([stationId, createdAt], map: "idx_support_station_created")
  @@index([status], map: "idx_support_status")
  @@map("support_tickets")
}

