  regulator_tasks regulator_tasks               @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_regulator_task_notes_task")

  @@index([author_user_id], map: "idx_regulator_task_notes_author")
  @@index([task_id, created_at], map: "idx_regulator_task_notes_task_time")
}

model regulator_task_activity_logs {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
