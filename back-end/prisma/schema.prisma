  @@index([action, created_at], map: "idx_regulator_task_activity_action_time")
  @@index([actor_user_id], map: "idx_regulator_task_activity_actor")
  @@index([task_id, created_at], map: "idx_regulator_task_activity_task_time")
}

model regulator_task_evidence {
