  public_id        String                            @unique(map: "public_id") @db.Char(26)
  station_id       BigInt                            @db.UnsignedBigInt
  initiated_by     BigInt                            @db.UnsignedBigInt
  related_flag_id  BigInt?                           @db.UnsignedBigInt
  action_type      enforcement_actions_action_type
  action_notes     String?                           @db.Text
  action_status    enforcement_actions_action_status @default(OPEN)
  issued_at        DateTime                          @default(now()) @db.Timestamp(3)
  resolved_at      DateTime?                         @db.Timestamp(3)
  compliance_flags compliance_flags?                 @relation(fields: [related_flag_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_enforcement_flag")
  mera_users       mera_users                        @relation("enforcement_actions_actor", fields: [initiated_by], references: [id], onUpdate: Restrict, map: "fk_enforcement_actor")
  stations         stations                          @relation(fields: [station_id], references: [id], onUpdate: Restrict, map: "fk_enforcement_station")

  @@index([related_flag_id], map: "idx_enforcement_flag")
  @@index([station_id, action_status, issued_at], map: "idx_enforcement_station_status")
}

model station_status_logs {
  id                  BigInt                                @id @default(autoincrement()) @db.UnsignedBigInt
  station_id          BigInt                                @db.UnsignedBigInt
