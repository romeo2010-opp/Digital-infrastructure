  availability_status station_status_logs_availability_status @default(UNKNOWN)
  diesel_status       station_status_logs_availability_status @default(UNKNOWN)
  petrol_status       station_status_logs_availability_status @default(UNKNOWN)
  updated_by          BigInt?                               @db.UnsignedBigInt
  created_at          DateTime                              @default(now()) @db.Timestamp(3)
  mera_users          mera_users?                           @relation(fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_station_status_logs_user")
  stations            stations                              @relation(fields: [station_id], references: [id], onUpdate: Restrict, map: "fk_station_status_logs_station")

  @@index([reported_source, created_at], map: "idx_station_status_logs_source_time")
  @@index([station_id, created_at], map: "idx_station_status_logs_station_time")
}

model fuel_price_reports {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
