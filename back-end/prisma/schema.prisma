  @@index([station_id, created_at], map: "idx_fuel_price_reports_station_time")
}

model regulator_tasks {
  id                           BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  task_number                  String?                        @unique(map: "task_number") @db.VarChar(32)
  title                        String                         @db.VarChar(180)
  description                  String                         @db.Text
  type                         regulator_tasks_type
  category                     String?                        @db.VarChar(96)
  priority                     regulator_tasks_priority       @default(MEDIUM)
  status                       regulator_tasks_status         @default(ASSIGNED)
  district                     String?                        @db.VarChar(80)
  station_id                   BigInt?                        @db.UnsignedBigInt
  station_name                 String?                        @db.VarChar(160)
  linked_entity_type           String?                        @db.VarChar(64)
  linked_entity_id             String?                        @db.VarChar(96)
  evidence_summary             String?                        @db.Text
  assigned_to_user_id          BigInt                         @db.UnsignedBigInt
  assigned_by_user_id          BigInt                         @db.UnsignedBigInt
  due_at                       DateTime?                      @db.Timestamp(3)
  acknowledged_at              DateTime?                      @db.Timestamp(3)
  started_at                   DateTime?                      @db.Timestamp(3)
  completed_at                 DateTime?                      @db.Timestamp(3)
  cancelled_at                 DateTime?                      @db.Timestamp(3)
  escalated_at                 DateTime?                      @db.Timestamp(3)
  completion_notes             String?                        @db.Text
  created_at                   DateTime                       @default(now()) @db.Timestamp(3)
  updated_at                   DateTime                       @default(now()) @db.Timestamp(3)
  deleted_at                   DateTime?                      @db.Timestamp(3)
  regulator_task_activity_logs regulator_task_activity_logs[]
  regulator_task_evidence      regulator_task_evidence[]
  regulator_task_notes         regulator_task_notes[]
  regulator_task_watchers      regulator_task_watchers[]
  assigned_by                  mera_users                     @relation("regulator_tasks_assigned_by", fields: [assigned_by_user_id], references: [id], onUpdate: Restrict, map: "fk_regulator_tasks_assigned_by")
  assigned_to                  mera_users                     @relation("regulator_tasks_assigned_to", fields: [assigned_to_user_id], references: [id], onUpdate: Restrict, map: "fk_regulator_tasks_assigned_to")
  stations                     stations?                      @relation(fields: [station_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_regulator_tasks_station")

  @@index([assigned_by_user_id], map: "idx_regulator_tasks_assigned_by")
  @@index([assigned_to_user_id], map: "idx_regulator_tasks_assigned_to")
  @@index([created_at], map: "idx_regulator_tasks_created_at")
  @@index([district], map: "idx_regulator_tasks_district")
  @@index([due_at], map: "idx_regulator_tasks_due_at")
  @@index([linked_entity_type, linked_entity_id], map: "idx_regulator_tasks_linked_entity")
  @@index([priority], map: "idx_regulator_tasks_priority")
  @@index([station_id], map: "idx_regulator_tasks_station")
  @@index([status], map: "idx_regulator_tasks_status")
}

model regulator_task_notes {
  id             BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  task_id        BigInt                         @db.UnsignedBigInt
  author_user_id BigInt                         @db.UnsignedBigInt
  note           String                         @db.Text
