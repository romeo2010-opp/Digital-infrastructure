PORT=4307
DATABASE_URL=mysql://smartlink_schools:password@127.0.0.1:3306/smartlink_schools
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Optional dedicated secret for the isolated internal Team Suite. If omitted,
# the server derives a separate Team Suite key from JWT_SECRET.
TEAM_JWT_SECRET=replace-with-an-independent-long-random-secret
TEAM_JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5307,http://localhost:5309,http://127.0.0.1:5307,http://127.0.0.1:5309
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_TIMEOUT_MS=180000
AI_LOGIN_CHECK_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_LOG_RAW_RESPONSES=true
AI_REQUIRE_TEACHER_APPROVAL=true
# Academic intelligence narration is opt-in and never required for deterministic calculations.
ACADEMIC_AI_ENABLED=false
ACADEMIC_AI_PROVIDER=gemini
ACADEMIC_AI_MODEL=gemini-2.5-flash
ACADEMIC_AI_TIMEOUT_MS=15000
ACADEMIC_AI_MAX_RETRIES=2
ACADEMIC_AI_DAILY_BUDGET=0
# Provider credential selected by ACADEMIC_AI_PROVIDER. Leave unused providers blank.
ANTHROPIC_API_KEY=
# Imported exams use a dedicated high-detail PDF vision provider. OpenAI's
# Responses API reads both the PDF text and rendered page images.
ASSESSMENT_VISION_AI_PROVIDER=openai
ASSESSMENT_VISION_AI_MODEL=gpt-5.4
ASSESSMENT_VISION_DETAIL=high
ASSESSMENT_VISION_MAX_OUTPUT_TOKENS=60000
ASSESSMENT_VISION_FALLBACK_PROVIDER=gemini
ASSESSMENT_VISION_FALLBACK_MODEL=gemini-2.5-flash
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_TTS_ENABLED=true
GEMINI_TTS_VOICE=Aoede
GEMINI_TTS_TIMEOUT_MS=45000
TIMETABLE_SOLVER_URL=http://127.0.0.1:7317
TIMETABLE_SOLVER_INTERNAL_TOKEN=replace-with-the-same-internal-token-used-by-the-python-solver
TIMETABLE_SOLVER_TIMEOUT_SECONDS=60
TIMETABLE_SOLVER_MAX_ALTERNATIVES=3
TIMETABLE_SOLVER_DEFAULT_TIME_LIMIT_SECONDS=20
SCHOOL_TIMEZONE=Africa/Blantyre
